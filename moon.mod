name = "moonbitstack/moonward"

version = "0.2.2"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonward"

license = "Apache-2.0"

keywords = [
  "resilience",
  "fault-tolerance",
  "circuit-breaker",
  "rate-limit",
  "rate-limiter",
  "token-bucket",
  "sliding-window",
  "load-shedding",
  "backoff",
  "retry",
  "deadline",
  "timeout",
  "throttling",
  "moonbit",
]

description = "Resilience for MoonBit without I/O: circuit breaking, load shedding, rate limits and deadlines."

source = "src"

import {
  "moonbitstack/moondate@0.1.5",
}
